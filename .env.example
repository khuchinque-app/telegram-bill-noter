# Bill Noter bot configuration.
# Copy to `.env` and fill in — never commit real tokens.

# Telegram bot token from @BotFather (REQUIRED to run the live bot)
BILL_NOTER_TOKEN=

# Path to the JSON file where notes are stored (optional, defaults to notes.json)
BILL_NOTER_STORE=notes.json

# Default chat to monitor (used by catch-up / gateway scripts, optional)
DEFAULT_CHAT_ID=
